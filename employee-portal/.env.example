# ============================================================
# Employee Portal - Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# API Configuration
API_BASE_URL=http://localhost:8080/api/v1
API_TIMEOUT=30000

# Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=86400

# Application
APP_NAME=Employee Portal
APP_VERSION=1.0.0
APP_ENV=development

# Feature Flags
FEATURE_PAYROLL_ENABLED=true
FEATURE_LEAVE_MANAGEMENT_ENABLED=true
FEATURE_PERFORMANCE_REVIEW_ENABLED=false

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# External Services
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password

# Analytics (optional)
ANALYTICS_TRACKING_ID=UA-XXXXXXXXX-X
